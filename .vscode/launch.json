{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "0 - Extract JSONs",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/0_extract_jsons.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "1 - Move to DB",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.1_move_to_db",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--db_name",
                "physiq_db"
            ]
        },
        {
            "name": "2 - Simulation testing",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.2_simulation_testing",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--start_template",
                "0",
                "--start_iteration",
                "0",
                "--iterations",
                "100",
                "--db_name",
                "physiq_db",
                //"--visualize",
                //"--debug",
            ]
        },
        {
            "name": "3 - Good proposals identification",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.3_good_proposals_identification",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--start_template",
                "2",
                "--iterations",
                "3",
                "--num_proposals",
                "1",
                "--db_name",
                "physiq_db",
                "--visualize"
                //"--save_to_db"
            ]
        },
        {
            "name": "Simulate test set",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.2_simulation_testing",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--iterations",
                "1",
                "--db_name",
                "physiq_db",
                "--visualize",
                "--debug",
                "--templates_type",
                "TEST"
            ]
        },
    ]
}