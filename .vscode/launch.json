    "version": "0.2.0",
    "configurations": [
        {
            "name": "0 - Extract JSONs",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/0_extract_jsons.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "1 - Move to DB",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.1_move_to_db",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "physiq_db"
            ]
        },
        {
            "name": "2 - Simulation testing",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.2_simulation_testing",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--start_template",
                "5",
                "--iterations",
                "1",
                "--visualize"
            ]
        }
    ]
}